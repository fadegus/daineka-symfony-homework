{% extends 'base.html.twig' %}

{% block body %}
    <h1>{{ title }}</h1>

    <div class="row">
        <ul class="list-group">
        {% for note in notes %}
            <li class="list-group-item list-group-item-action {{ note.statusdone == 1 ? 'list-group-item-dark' : 'list-group-item-info' }}">
                <a href="{{ path('note_show', {'id': note.id}) }}">{{ note.name }}</a>   
                <a href="{{ path('note_edit', {'id': note.id}) }}" class="btn btn-warning">Edit</a> 
                <a href="{{ path('note_delete', {'id': note.id}) }}" class="btn btn-danger">Delete</a>
                <a href="{{ path('note_send', {'id': note.id}) }}" class="btn btn-info">Отправить на email 🚀</a>
            </li>
        {% endfor %}
        </ul>
    </div>

    <div class="row">
        <a href="{{ path('note_new') }}" class="btn btn-success">Add</a>
    </div>
{% endblock %}
